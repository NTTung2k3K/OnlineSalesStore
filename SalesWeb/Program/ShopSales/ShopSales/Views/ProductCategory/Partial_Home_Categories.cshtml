@model IEnumerable<ShopSales.Models.EF.ProductCategory>

@foreach (var i in Model)
{
    var strImage = string.IsNullOrEmpty(i.Image) ? "" : i.Image;
    <div class="col-md-4">
        <div class="banner_item align-items-center" style="background-image:url(@strImage)">
            <div class="banner_category">
                <a href="categories.html">@i.Title's</a>
            </div>
        </div>
    </div>
}

