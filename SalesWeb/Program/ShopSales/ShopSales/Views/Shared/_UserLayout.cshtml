@using ShopSales.Models;
@using ShopSales.Models.EF;
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ShopSales.Models.Common.SystemHelper.GetValue().SettingTitle</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="Colo Shop Template">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="~/Content/User/styles/bootstrap4/bootstrap.min.css">
    <link href="~/Content/User/plugins/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" type="text/css" href="~/Content/User/plugins/OwlCarousel2-2.2.1/owl.carousel.css">
    <link rel="stylesheet" type="text/css" href="~/Content/User/plugins/OwlCarousel2-2.2.1/owl.theme.default.css">
    <link rel="stylesheet" type="text/css" href="~/Content/User/plugins/OwlCarousel2-2.2.1/animate.css">
    <link rel="stylesheet" type="text/css" href="~/Content/User/styles/main_styles.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/User/plugins/jquery-ui-1.12.1.custom/jquery-ui.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/Content/User/js/jquery-3.2.1.min.js"></script>
    <link href="~/Content/PagedList.css" rel="stylesheet" />
    <link href="~/Content/User/styles/myCode.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Content/User/styles/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    @RenderSection("link", false)
</head>

<body>

    <div class="super_container">

        <!-- Header -->

        <header class="header trans_300">

            <!-- Top Navigation -->

            <div class="top_nav">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="top_nav_left">Hotline: <span style="color:orange;">@ShopSales.Models.Common.SystemHelper.GetValue().SettingHotline</span></div>
                        </div>
                        <div class="col-md-6 text-right">
                            <div class="top_nav_right">
                                <ul class="top_nav_menu">

                                    <!-- Currency / Language / My Account -->

                                    <li class="currency">
                                        <a href="#">
                                            usd
                                            <i class="fa fa-angle-down"></i>
                                        </a>
                                        <ul class="currency_selection">
                                            <li><a href="#">cad</a></li>
                                            <li><a href="#">aud</a></li>
                                            <li><a href="#">eur</a></li>
                                            <li><a href="#">gbp</a></li>
                                        </ul>
                                    </li>
                                    <li class="language">
                                        <a href="#">
                                            English
                                            <i class="fa fa-angle-down"></i>
                                        </a>
                                        <ul class="language_selection">
                                            <li><a href="#">French</a></li>
                                            <li><a href="#">Italian</a></li>
                                            <li><a href="#">German</a></li>
                                            <li><a href="#">Spanish</a></li>
                                        </ul>
                                    </li>
                                    <li class="account">
                                        <a href="#">
                                            My Account
                                            <i class="fa fa-angle-down"></i>
                                        </a>
                                        <ul class="account_selection">
                                            <li><a href="#"><i class="fa fa-sign-in" aria-hidden="true"></i>Sign In</a></li>
                                            <li><a href="#"><i class="fa fa-user-plus" aria-hidden="true"></i>Register</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Navigation -->

            <div class="main_nav_container">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12 text-right">
                            <div class="logo_container">
                                @{ var settingTitle = ShopSales.Models.Common.SystemHelper.GetValue().SettingTitle; }
                                <a href="/">Shop<span>@settingTitle.ToString()</span></a>
                            </div>
                            <nav class="navbar">
                                <ul class="navbar_menu">
                                    @Html.Action("Partial_Home", "Category")
                                </ul>
                                <ul class="navbar_user">
                                    <li><a href="#"><i class="fa fa-search" aria-hidden="true"></i></a></li>
                                    <li><a href="#"><i class="fa fa-user" aria-hidden="true"></i></a></li>
                                    <li class="checkout">
                                        <a href="/shopping-cart">
                                            <i class="fa fa-shopping-cart" aria-hidden="true"></i>

                                            @*@Html.Action("ShowNumberItem", "Product")*@

                                            @{ShopSales.Models.ShoppingCart i = (ShoppingCart)Session["Cart"];}
                                            @if (i == null)
                                            {
                                <span id="checkout_items" class="checkout_items">0</span> }
                            else
                            {
                <span id="checkout_items" class="checkout_items">@i.shoppingCarts.Count</span>}
                                        </a>


                                    </li>
                                </ul>
                                <div class="hamburger_container">
                                    <i class="fa fa-bars" aria-hidden="true"></i>
                                </div>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>

        </header>

        <div>
            @RenderBody()
        </div>

        <!-- Newsletter -->

        <div class="newsletter">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="newsletter_text d-flex flex-column justify-content-center align-items-lg-start align-items-md-center text-center">
                            <h4>Newsletter</h4>
                            <p>Subscribe to our newsletter and get 20% off your first purchase</p>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <form action="post">
                            <div class="newsletter_form d-flex flex-md-row flex-column flex-xs-column align-items-center justify-content-lg-end justify-content-center">
                                <input id="newsletter_email" type="email" placeholder="Your email" required="required" data-error="Valid email is required.">
                                <button id="newsletter_submit" type="submit" class="newsletter_submit_btn trans_300" value="Submit">subscribe</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->

        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="footer_nav_container d-flex flex-sm-row flex-column align-items-center justify-content-lg-start justify-content-center text-center">
                            <ul class="footer_nav">
                                <li><a href="#">Blog</a></li>
                                <li><a href="#">FAQs</a></li>
                                <li><a href="/contact">Contact us</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="footer_social d-flex flex-row align-items-center justify-content-lg-end justify-content-center">
                            <ul>
                                @if (ShopSales.Models.Common.SystemHelper.GetValue().LinkFacebook != null && !string.IsNullOrEmpty(ShopSales.Models.Common.SystemHelper.GetValue().LinkFacebook))
                                {
                    <li><a href="@ShopSales.Models.Common.SystemHelper.GetValue().LinkFacebook" target="_blank"><i class="fa-brands fa-facebook"></i></a></li>
}
                                @if (ShopSales.Models.Common.SystemHelper.GetValue().LinkTwitter != null && !string.IsNullOrEmpty(ShopSales.Models.Common.SystemHelper.GetValue().LinkTwitter))
                                {
                    <li><a href="@ShopSales.Models.Common.SystemHelper.GetValue().LinkTwitter" target="_blank"><i class="fa-brands fa-twitter" aria-hidden="true"></i></a></li>
}
                                @if (ShopSales.Models.Common.SystemHelper.GetValue().LinkInstagram != null && !string.IsNullOrEmpty(ShopSales.Models.Common.SystemHelper.GetValue().LinkInstagram))
                                {
                    <li><a href="@ShopSales.Models.Common.SystemHelper.GetValue().LinkInstagram" target="_blank"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a></li>
}
                                @if (ShopSales.Models.Common.SystemHelper.GetValue().LinkSkype != null && !string.IsNullOrEmpty(ShopSales.Models.Common.SystemHelper.GetValue().LinkSkype))
                                {
                    <li><a href="@ShopSales.Models.Common.SystemHelper.GetValue().LinkSkype" target="_blank"><i class="fa-brands fa-skype" aria-hidden="true"></i></a></li>
}
                                @if (ShopSales.Models.Common.SystemHelper.GetValue().LinkPinterest != null && !string.IsNullOrEmpty(ShopSales.Models.Common.SystemHelper.GetValue().LinkPinterest))
                                {
                            <li><a href="@ShopSales.Models.Common.SystemHelper.GetValue().LinkPinterest" target="_blank"><i class="fa-brands fa-pinterest" aria-hidden="true"></i></a></li>}




                                
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="footer_nav_container">
                            <div class="cr">©2018 All Rights Reserverd. Made with <i class="fa fa-heart-o" aria-hidden="true"></i> by <a href="#">Colorlib</a> &amp; distributed by <a href="https://themewagon.com">ThemeWagon</a></div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>

    </div>
    <script src="~/Content/User/js/jquery-3.2.1.min.js"></script>
    <script src="~/Content/User/styles/bootstrap4/popper.js"></script>
    <script src="~/Content/User/styles/bootstrap4/bootstrap.min.js"></script>
    <script src="~/Content/User/plugins/Isotope/isotope.pkgd.min.js"></script>
    <script src="~/Content/User/plugins/OwlCarousel2-2.2.1/owl.carousel.js"></script>
    <script src="~/Content/User/plugins/easing/easing.js"></script>
    <script src="~/Content/User/js/custom.js"></script>
    <script src="~/Content/User/plugins/jquery-ui-1.12.1.custom/jquery-ui.js"></script>
    @RenderSection("script", false)

</body>

</html>
