@model IEnumerable<ShopSales.Models.EF.Post>
@foreach (var i in Model)
{
    var strImage = i.Image == null ? "" : i.Image;

    <div class="col-lg-4 blog_item_col">
        <div class="blog_item">
            <div class="blog_background" style="background-image:url(@strImage);"></div>
            <div class="blog_content d-flex flex-column align-items-center justify-content-center text-center">
                <h4 class="blog_title">Here are the trends I see coming this fall</h4>
                <span class="blog_meta">by admin | @i.ModifiedDate.ToString("dd/MM/yyyy")</span>
                <a class="blog_more" href="#">Read more</a>
            </div>
        </div>
    </div>
}


