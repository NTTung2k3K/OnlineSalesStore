@model IEnumerable<ShopSales.Models.EF.ProductCategory>

@if(@ViewBag.ProductCategoryId == null)
{
    <li class="active"><a href="/product"><span><i class="fa fa-angle-double-right" aria-hidden="true"></i></span>All</a></li>
}
else
{
<li><a href="/product">All</a></li>
}

@foreach (var i in Model)
{
    if (i.ProductCategoryId == @ViewBag.ProductCategoryId)
    {
        <li class="active"><a href="/list-of-products/@i.Alias-@i.ProductCategoryId"><span><i class="fa fa-angle-double-right" aria-hidden="true"></i></span>@i.Title</a></li> }
    else
    {
        <li><a href="/list-of-products/@i.Alias-@i.ProductCategoryId">@i.Title</a></li>
    }
}
