@model ShopSales.Models.EF.Category
@{
    ViewBag.Title = "AddCategory";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>AddCategory</h2>
@using (Html.BeginForm("AddCategory", "Category", FormMethod.Post, new { }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false)
    <!-- Horizontal Form -->
    <div class="card card-info">
        <div class="card-header">
            <h3 class="text-center card-title">Category Management</h3>
        </div>
        <!-- /.card-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="card-body">
                <div class="col-md-12">
                    <div class="form-group row">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">Name</label>
                        @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @placeholder = "Name" })
                        @Html.ValidationMessageFor(x => x.Title, null , new {@class = "text-danger"})
                    </div>
                    <div class="form-group row ">
                        <label for="inputPassword3" class="col-sm-2 col-form-label">Description</label>
                        @Html.TextAreaFor(x => x.Description, new {@class = "form-control", @placeholder = "Description"})
                    </div>
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Position</label>
                    @Html.TextBoxFor(x => x.Position, new { @class = "form-control", @placeholder = "Position"})
                    @Html.ValidationMessageFor(x => x.Position,null,new {@class = "text-danger"})
                </div>

                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Name</label>
                    @Html.TextBoxFor(x => x.SeoTitle, new { @class = "form-control", @placeholder = "Seo Name" })
                    @Html.ValidationMessageFor(x => x.SeoTitle, null, new { @class = "text-danger" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Descripiton</label>
                    @Html.TextAreaFor(x => x.SeoDescription, new { @class = "form-control", @placeholder = "Seo Description" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Keywords</label>
                    @Html.TextAreaFor(x => x.SeoKeyword, new { @class = "form-control", @placeholder = "Seo keywords" })

            </div>
            <!-- /.card-body -->
                <div class="card-footer">
                    <button type="submit" class="btn  btn-success float-left">Create</button>

                    <a href="~/Admin/Category/Index" class="btn btn-info float-right">Cancel</a>
                </div>
            <!-- /.card-footer -->
        </form>
    </div> <!-- /.card -->


}
