@model ShopSales.Models.EF.Category
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h2>Edit Category</h2>

@using (Html.BeginForm("Edit", "Category", FormMethod.Post, new { }))
{
    @Html.ValidationSummary(false)
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.CategoryId)
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">Category Management</h3>
        </div>
        <!-- /.card-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="card-body">
                <div class="form-group row">
                    <label for="inputEmail3" class="col-sm-2 col-form-label">Name</label>
                    @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @value = Model.Title})
                    @Html.ValidationMessageFor(x => x.Title,null ,new { @class = "text-danger" })
                </div>
                <div class="form-group row">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Description</label>
                    @Html.TextAreaFor(x => x.Description, new {@class = "form-control", @value = Model.Description})
                </div>
                <div class="form-group row">
                    <label for="inputEmail3" class="col-sm-2 col-form-label">Position</label>
                    @Html.TextBoxFor(x => x.Position, new { @class = "form-control", @value = Model.Position })
                    @Html.ValidationMessageFor(x => x.Position, null, new { @class = "text-danger" })

                </div>
                <div class="form-group row">
                    <label for="inputEmail3" class="col-sm-2 col-form-label">Seo Name</label>
                    @Html.TextBoxFor(x => x.SeoTitle, new { @class = "form-control", @value = Model.SeoTitle })
                    @Html.ValidationMessageFor(x => x.SeoTitle, null, new { @class = "text-danger" })
                </div>
                <div class="form-group row">
                    <label for="inputEmail3" class="col-sm-2 col-form-label">Seo Description</label>
                    @Html.TextAreaFor(x => x.SeoDescription, new { @class = "form-control", @value = Model.SeoDescription })

                </div>
                <div class="form-group row">
                    <label for="inputEmail3" class="col-sm-2 col-form-label">Seo Keywords</label>
                    @Html.TextBoxFor(x => x.SeoKeyword, new { @class = "form-control", @value = Model.SeoKeyword })
                </div>



            </div>
            <!-- /.card-body -->
            <div class="card-footer">
                <button type="submit" class="btn  btn-success float-left">Edit</button>

                <a href="~/Admin/Category/Index" class="btn btn-info float-right">Cancel</a>
            </div>
            <!-- /.card-footer -->
        </form>
    </div>

}


