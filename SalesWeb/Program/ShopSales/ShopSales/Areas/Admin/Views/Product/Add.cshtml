@model ShopSales.Models.EF.Product
@{
    ViewBag.Title = "Add";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@using (Html.BeginForm("Add", "Product", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false)
    @Html.HiddenFor(x => x.ProductCategory)
    <!-- Horizontal Form -->
    <div class="card card-info">
        <div class="card-header">
            <h3 class="text-center card-title">Add Product </h3>
        </div>
        <!-- /.card-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="card-body">
                <div class="col-md-12">
                    <div class="form-group row">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">Name</label>
                        @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @placeholder = "Name" })
                        @Html.ValidationMessageFor(x => x.Title, null, new { @class = "text-danger" })
                    </div>
                    <div class="form-group row ">
                        <label for="inputPassword3" class="col-sm-2 col-form-label">Alias</label>
                        @Html.TextAreaFor(x => x.Alias, new { @class = "form-control", @placeholder = "Alias" })
                        @Html.ValidationMessageFor(x => x.Alias, null, new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">SKU</label>
                    @Html.TextAreaFor(x => x.ProductCode, new { @class = "form-control", @placeholder = "SKU" })
                    @Html.ValidationMessageFor(x => x.ProductCode, null, new { @class = "text-danger" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Category</label>
                    @Html.DropDownListFor(x => x.ProductCategoryId, (SelectList)ViewBag.listProductCategory, "Select Category")
                    @Html.ValidationMessageFor(x => x.ProductCategoryId, null, new { @class = "text-danger" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Description</label>
                    @Html.TextAreaFor(x => x.Description, new { @class = "form-control", @placeholder = "Description" })
                </div>
                <div class="row">
                    <div class="col-md-4" style="padding: 0 10px;">
                        <div class="form-group row ">
                            <label for="inputPassword3" class="col-form-label">Quantity</label>
                            @Html.TextBoxFor(x => x.Quantity, new { @class = "form-control", @placeholder = "Quantity" })
                            @Html.ValidationMessageFor(x => x.Quantity, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4" style="padding: 0 10px;">
                        <div class="form-group row ">
                            <label for="inputPassword3" class=" col-form-label">Price</label>
                            @Html.TextBoxFor(x => x.Price, new { @class = "form-control", @placeholder = "Price", @value = "0" })
                            @Html.ValidationMessageFor(x => x.Price, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4" style="padding: 0 10px;">
                        <div class="form-group row ">
                            <label for="inputPassword3" class="col-form-label">PriceSale</label>
                            @Html.TextBoxFor(x => x.PriceSale, new { @class = "form-control", @placeholder = "PriceSale" ,@value = "0"})
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <label for="inputPassword3" class="col-form-label">Discount Start</label>
                        @Html.TextBoxFor(x => x.DiscountStart, new { @type = "date"})
                    </div>
                    <div class="col-md-3">
                        <label for="inputPassword3" class="col-form-label">Discount End</label>
                        @Html.TextBoxFor(x => x.DiscountEnd, new { @type = "date" })
                    </div>
                </div>
                <div class="form-group">
                    <label>Image</label>
                    <input type="button" value="Browse" style="color:blue" onclick="BroserServer()" />
                </div>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="text-center">No</th>
                            <th class="text-center">Image</th>
                            <th class="text-center">Avatar</th>
                            <th class="text-center">Setting</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        <tr>

                            <td colspan="4">NO Image</td>
                        </tr>
                    </tbody>
                </table>

                <div class="form-group ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Detail</label>
                    @Html.TextAreaFor(x => x.Detail, new { @id = "", @class = "form-control", @placeholder = "Detail" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Name</label>
                    @Html.TextBoxFor(x => x.SeoTitle, new { @class = "form-control", @placeholder = "Seo Name" })
                    @Html.ValidationMessageFor(x => x.SeoTitle, null, new { @class = "text-danger" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Descripiton</label>
                    @Html.TextAreaFor(x => x.SeoDescripiton, new { @class = "form-control", @placeholder = "Seo Description" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Keywords</label>
                    @Html.TextBoxFor(x => x.SeoKeyword, new { @class = "form-control", @placeholder = "Seo keywords" })

                </div>
                <div class="form-group row">
                    <div class="col-md-2 text-center">
                        <div>
                            <label for="inputPassword3" class="col-form-label">Display</label>

                            @Html.CheckBoxFor(x => x.isActive, new { @class = "form-control", @placeholder = "State", @checked = "checked" })
                        </div>
                    </div>
                    
                    <div class="col-md-2 text-center">
                        <div>
                            <label for="inputPassword3" class="col-form-label">New</label>

                            @Html.CheckBoxFor(x => x.isNew, new { @class = "form-control", @placeholder = "State", @checked = "checked" })
                        </div>
                    </div>
                    <div class="col-md-2 text-center">
                        <div>
                            <label for="inputPassword3" class="col-form-label">Home</label>

                            @Html.CheckBoxFor(x => x.isHome, new { @class = "form-control", @placeholder = "State" })
                        </div>
                    </div>            
                    <div class="col-md-2 text-center">
                        <div>
                            <label for="inputPassword3" class="col-form-label">Sell</label>

                            @Html.CheckBoxFor(x => x.isSell, new { @class = "form-control", @placeholder = "State" })
                        </div>
                    </div>

                </div>
                <!-- /.card-body -->
                <div class="card-footer">
                    <button id="aaa" type="submit" class="btn  btn-success float-left" style="background-color: forestgreen; color: white;">Create</button>

                    <a href="~/Admin/Product/Index" class="btn btn-info float-right">Cancel</a>
                </div>
            </div>

            <!-- /.card-footer -->
        </form>
    </div> <!-- /.card -->


}
@section script{
    <script>
       

        $(document).ready(function () {
            CKEDITOR.replace('txtDetail', {
                customConfig: '/Content/CK/ckeditor/config.js',
                extraAllowedControl: 'span',
            });
        })

        function BroserServer() {
            var finder = new CKFinder();
            finder.selectActionFunction = function (fileUrl) {
                addImage(fileUrl)
            };
            finder.popup();
        }
        var no = 0;
        function addImage(url) {
            no++;
            if ($('#tbody').find('td[colspan="4"]').length > 0) {
                $('#tbody').empty();
            }
            if (no === 1) {
                var str = `<tr data-id="${no}" >
                                            <td class="text-center" >${no}</td>
                                            <td class="text-center d-flex justify-content-center">  <img src="${url} " style="width: 80px; height: 80px;"/> <input type="hidden" name="Image" value="${url}"/> </td>
                                            <td class="text-center">  <input name="isDefault" value="${no}" type="radio" checked style="height: 71px; width: 30px;"/></td>
                                            <td class="text-center"><a class="btn btn-danger" onclick="deleteImage(this)">Delete</a></td>
                                        </tr>`;
            } else {
                var str = `<tr data-id="${no}" >
                                            <td class="text-center" >${no}</td>
                                            <td class="text-center d-flex justify-content-center">  <img  src="${url} " style="width: 80px; height: 80px;"/> <input type="hidden" name="Image" value="${url}"/> </td>
                                            <td class="text-center">  <input name="isDefault" value="${no}" type="radio" style="height: 71px; width: 30px;"/></td>
                                            <td class="text-center"><a class="btn btn-danger" onclick="deleteImage(this)">Delete</a></td>
                                        </tr>`;
            }



            $('#tbody').append(str);
        }

        $('#aaa').on('click', function () {
            var ckeditorContent = CKEDITOR.instances['txtDetail'].getData();
            var a = $("#txtDetail").val(ckeditorContent);
            console.log(ckeditorContent);
        })

        function deleteImage(element) {
            var parent = $(element).parents('tr');
            parent.remove();
        }


    </script>


}