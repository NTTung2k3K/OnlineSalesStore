@model ShopSales.Models.EF.ProductCategory
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@using (Html.BeginForm("Edit", "ProductCategory", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false)
    @Html.HiddenFor(x => x.ProductCategoryId)
    @Html.HiddenFor(x => x.CreateDate)

    <!-- Horizontal Form -->
    <div class="card card-info">
        <div class="card-header">
            <h3 class="text-center card-title">Product's Category Management</h3>
        </div>
        <!-- /.card-header -->
        <!-- form start -->
        <form class="form-horizontal">
            <div class="card-body">
                <div class="col-md-12">
                    <div class="form-group row">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">Name</label>
                        @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @placeholder = "Name" })
                        @Html.ValidationMessageFor(x => x.Title, null, new { @class = "text-danger" })
                    </div>

                </div>
                <div class="col-md-12">
                    <div class="form-group row">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">Image</label>
                        @Html.TextBoxFor(x => x.Image, new { @class = "form-control", @placeholder = "Name", @id = "txtImage" })
                        <div class="input-group-append">
                            <input type="button" value="Browse" onclick="BroserServer('txtImage')" />
                        </div>
                    </div>

                </div>


                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Name</label>
                    @Html.TextBoxFor(x => x.SeoTitle, new { @class = "form-control", @placeholder = "Seo Name" })
                    @Html.ValidationMessageFor(x => x.SeoTitle, null, new { @class = "text-danger" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Descripiton</label>
                    @Html.TextAreaFor(x => x.SeoDescripiton, new { @class = "form-control", @placeholder = "Seo Description" })
                </div>
                <div class="form-group row ">
                    <label for="inputPassword3" class="col-sm-2 col-form-label">Seo Keywords</label>
                    @Html.TextAreaFor(x => x.SeoKeyword, new { @class = "form-control", @placeholder = "Seo keywords" })

                </div>

                <!-- /.card-body -->
                <div class="card-footer">
                    <button type="submit" class="btn" style="background-color:forestgreen; color: white;">Edit</button>

                    <a href="~/Admin/ProductCategory/Index" class="btn btn-info float-right">Cancel</a>
                </div>
                <!-- /.card-footer -->
</form>
    </div> <!-- /.card -->


}
@section script{
    <script>

    </script>


}